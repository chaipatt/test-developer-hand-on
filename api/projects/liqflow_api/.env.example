# liqflow_api configuration (env prefix LIQFLOW_API_). Copy to .env for local
# dev. NEVER put real secrets here — this repo is public.

# asyncpg-compatible Postgres DSN.
LIQFLOW_API_POSTGRES_DSN=postgresql://liqflow:liqflow@localhost:5432/liqflow
LIQFLOW_API_PG_MIN_CONNECTIONS=1
LIQFLOW_API_PG_MAX_CONNECTIONS=10

# Binance TH public API.
LIQFLOW_API_BINANCE_BASE_URL=https://api.binance.th
LIQFLOW_API_POLL_INTERVAL_SECONDS=5
LIQFLOW_API_ORDERBOOK_LIMIT=20

# Symbols to poll (JSON array). USDTTHB is the only pair Liqflow uses today.
LIQFLOW_API_SYMBOLS=["USDTTHB"]

# HS256 secret for auth tokens. Dev-only default; override for anything real.
LIQFLOW_API_JWT_SECRET=dev-only-insecure-secret-change-me
LIQFLOW_API_JWT_EXPIRES_MINUTES=720

# HTTP bind (used by the entrypoint).
LIQFLOW_API_HOST=0.0.0.0
LIQFLOW_API_PORT=8000
