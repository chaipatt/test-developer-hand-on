# Example environment for local dev. Copy to .env and adjust as needed.
# NEVER put real secrets here — this repo is public. `docker compose up` works
# without any .env (compose.yaml sets sensible local defaults).

# ---- Python API (prefix LIQFLOW_API_) ----
LIQFLOW_API_POSTGRES_DSN=postgresql://liqflow:liqflow@localhost:5432/liqflow
LIQFLOW_API_BINANCE_BASE_URL=https://api.binance.th
LIQFLOW_API_POLL_INTERVAL_SECONDS=5
LIQFLOW_API_ORDERBOOK_LIMIT=20
# Outbound HTTP timeouts (seconds) for exchange calls — bound hung upstreams.
LIQFLOW_API_HTTP_TOTAL_TIMEOUT_SECONDS=10
LIQFLOW_API_HTTP_CONNECT_TIMEOUT_SECONDS=5
LIQFLOW_API_SYMBOLS=["USDTTHB"]
LIQFLOW_API_JWT_SECRET=dev-only-insecure-secret-change-me
LIQFLOW_API_JWT_EXPIRES_MINUTES=720

# ---- Next.js web / BFF ----
# Server-side base URL the BFF + middleware use to reach the Python API.
BACKEND_API_BASE_URL=http://localhost:8000
# Optional: override the default pair shown in the UI.
NEXT_PUBLIC_DEFAULT_SYMBOL=USDTTHB
